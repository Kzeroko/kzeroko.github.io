---
import { useTranslations, type LocaleCode, type UIKey } from '../../i18n';
import { wikiPath, type WikiGroup } from '../../lib/content';

interface Props {
  lang: LocaleCode;
  groups: WikiGroup[];
  /** Current pathname, used to mark the active entry. */
  current: string;
  class?: string;
}

const { lang, groups, current, class: className } = Astro.props;
const t = useTranslations(lang);

const normalised = current.replace(/\/+$/, '') + '/';
---

<nav class:list={['sidebar', className]} aria-label={t('nav.sectionNav')}>
  {
    groups.map((group) => (
      <section class="sidebar__group">
        <h2 class="sidebar__label">{t(`wiki.category.${group.category}` as UIKey)}</h2>
        <ul role="list">
          {group.entries.map((entry) => {
            const href = wikiPath(lang, entry);
            return (
              <li>
                <a href={href} aria-current={href === normalised ? 'page' : undefined}>
                  {entry.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    font-size: var(--fs-sm);
  }

  .sidebar__label {
    font-size: var(--fs-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-text-faint);
  }

  .sidebar ul {
    margin-block-start: var(--space-sm);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sidebar a {
    position: relative;
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--c-text-muted);
    line-height: var(--lh-snug);
    text-wrap: pretty;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .sidebar a:hover {
    color: var(--c-text);
    background: var(--c-surface-3);
  }

  .sidebar a[aria-current='page'] {
    color: var(--c-accent);
    background: var(--c-accent-soft);
    font-weight: var(--weight-medium);
  }

  /* Marker rail on the active entry, matching the table-of-contents idiom. */
  .sidebar a[aria-current='page']::before {
    content: '';
    position: absolute;
    inset-block: 0.35rem;
    inset-inline-start: 0;
    inline-size: 2px;
    border-radius: 2px;
    background: var(--c-accent);
  }
</style>
