---
import { getLocale, type LocaleCode } from '../../i18n';
import { SITE } from '../../data/site';
import type { SeoOutput } from '../../lib/seo';

interface Props {
  seo: SeoOutput;
  lang: LocaleCode;
  /** Extra structured data blocks appended after the site-level graph. */
  jsonLd?: unknown[];
  /** RSS feed for the current language. */
  feed?: string;
}

const { seo, lang, jsonLd = [], feed } = Astro.props;
const locale = getLocale(lang);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />

{seo.noindex && <meta name="robots" content="noindex, follow" />}

{
  seo.alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
  ))
}

<meta property="og:type" content={seo.type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta property="og:site_name" content={SITE.domain} />
<meta property="og:locale" content={locale.htmlLang.replace('-', '_')} />
{seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
{seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />

<meta name="theme-color" content={SITE.themeColor.dark} />
<meta name="color-scheme" content="dark light" />
<meta name="author" content={SITE.author} />

<link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{feed && <link rel="alternate" type="application/rss+xml" title={SITE.domain} href={feed} />}

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)}
/>

{/*
  Theme is resolved before first paint to avoid a flash of the wrong surface.
  Deliberately inline and synchronous — it is four lines and must not wait on
  the module graph.
*/}
<script is:inline define:vars={{ activeLang: lang }}>
  (() => {
    try {
      localStorage.setItem('ktm2:lang', activeLang);
    } catch {
      /* Storage blocked; the language gateway falls back to sniffing. */
    }
    try {
      const stored = localStorage.getItem('ktm2:theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.setAttribute('data-theme', stored);
        document.documentElement.dataset.themeChoice = stored;
      } else {
        document.documentElement.dataset.themeChoice = 'system';
      }
    } catch {
      document.documentElement.dataset.themeChoice = 'system';
    }
  })();
</script>
