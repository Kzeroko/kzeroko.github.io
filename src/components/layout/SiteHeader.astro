---
import BrandMark from './BrandMark.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from '../base/Icon.astro';
import { localePath, useTranslations, type LocaleCode } from '../../i18n';
import { PRIMARY_NAV, SOCIALS } from '../../data/site';

interface Props {
  lang: LocaleCode;
  pathname: string;
  /** Passed through to the language switcher; see `BaseLayoutProps`. */
  translatedPaths?: Partial<Record<LocaleCode, string>>;
}

const { lang, pathname, translatedPaths } = Astro.props;
const t = useTranslations(lang);

const home = localePath(lang);
const current = pathname.replace(/\/+$/, '') + '/';

const items = PRIMARY_NAV.map((item) => {
  const href = localePath(lang, item.path);
  return {
    ...item,
    href,
    // A section stays lit while the reader is anywhere inside it.
    active: current === href || current.startsWith(href),
  };
});

const socials = SOCIALS.filter((social) => social.primary);
---

<header class="header" data-site-header>
  <div class="header__inner shell shell--wide">
    <a class="brand" href={home} aria-label={t('site.title')}>
      <BrandMark id="header" />
      <span class="brand__text">
        <span class="brand__name">Kzeroko</span>
        <span class="brand__sub">KTM2</span>
      </span>
    </a>

    <nav class="nav" aria-label={t('nav.primary')}>
      <ul class="nav__list" role="list">
        {
          items.map((item) => (
            <li>
              <a
                class="nav__link"
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <button class="searchbtn" type="button" data-search-open aria-label={t('action.search')}>
        <Icon name="search" />
        <span class="searchbtn__label">{t('action.searchShort')}</span>
        <kbd class="searchbtn__kbd">/</kbd>
      </button>

      <div class="header__links">
        {
          socials.map((social) => (
            <a
              class="icon-btn"
              href={social.href}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={social.label}
            >
              <Icon name={social.icon} />
            </a>
          ))
        }
      </div>

      <ThemeToggle lang={lang} class="header__theme" />
      <LocaleSwitcher
        lang={lang}
        pathname={pathname}
        translatedPaths={translatedPaths}
        class="header__locale"
      />

      <button
        class="icon-btn header__burger"
        type="button"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <Icon name="menu" class="header__burger-open" />
        <Icon name="close" class="header__burger-close" />
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="mobile-nav" data-mobile-nav>
  <div class="drawer__scrim" data-mobile-nav-close></div>
  <div class="drawer__panel scroll-thin">
    <nav aria-label={t('nav.primary')}>
      <ul class="drawer__list" role="list">
        {
          items.map((item, index) => (
            <li style={`--i:${index}`}>
              <a
                class="drawer__link"
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
              >
                <span>{item.label[lang]}</span>
                <Icon name="arrowRight" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="drawer__foot">
      <ThemeToggle lang={lang} />
      <LocaleSwitcher lang={lang} pathname={pathname} translatedPaths={translatedPaths} expanded />
    </div>

    <div class="drawer__socials">
      {
        SOCIALS.map((social) => (
          <a
            class="icon-btn"
            href={social.href}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={social.label}
          >
            <Icon name={social.icon} />
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    view-transition-name: site-header;
    background: color-mix(in oklab, var(--c-bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    border-block-end: 1px solid transparent;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .header[data-condensed] {
    border-block-end-color: var(--c-line);
    background: color-mix(in oklab, var(--c-bg) 88%, transparent);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    block-size: var(--header-height);
  }

  /* ------------------------------------------------------------- brand -- */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    color: var(--c-text);
  }

  .brand__sub {
    font-size: var(--fs-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    color: var(--c-accent);
  }

  /* --------------------------------------------------------------- nav -- */

  .nav {
    flex: 1;
    min-inline-size: 0;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding: 0.45em 0.8em;
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--c-text);
  }

  .nav__link[aria-current='page'] {
    color: var(--c-text);
  }

  /* Underline grows from the centre on hover, pinned when the section is active. */
  .nav__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0.15em;
    inset-inline: 0.8em;
    block-size: 2px;
    border-radius: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav__link:hover::after {
    transform: scaleX(0.5);
  }

  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* ----------------------------------------------------------- actions -- */

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex: none;
    margin-inline-start: auto;
  }

  .searchbtn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.42em 0.6em 0.42em 0.7em;
    border-radius: var(--radius-full);
    border: 1px solid var(--c-line);
    background: var(--c-surface-2);
    color: var(--c-text-faint);
    font-size: var(--fs-xs);
    line-height: 1;
    transition:
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .searchbtn :global(.icon) {
    inline-size: 0.95rem;
    block-size: 0.95rem;
  }

  .searchbtn:hover {
    border-color: var(--c-line-strong);
    color: var(--c-text);
  }

  .searchbtn__label {
    min-inline-size: 3.2rem;
    text-align: start;
  }

  .searchbtn__kbd {
    padding: 0.05em 0.4em;
    border-radius: var(--radius-xs);
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header__burger {
    display: none;
  }

  .header__burger-close {
    display: none;
  }

  /* -------------------------------------------------------------- drawer -- */

  .drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    visibility: hidden;
    pointer-events: none;
  }

  .drawer[data-open] {
    visibility: visible;
    pointer-events: auto;
  }

  .drawer__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--hue-navy-900) 55%, transparent);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .drawer[data-open] .drawer__scrim {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(20rem, 84vw);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: calc(var(--header-height) + var(--space-lg)) var(--space-lg) var(--space-xl);
    background: var(--c-surface);
    border-inline-start: 1px solid var(--c-line);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .drawer[data-open] .drawer__panel {
    transform: translateX(0);
  }

  .drawer__list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer__list li {
    opacity: 0;
    transform: translateX(0.75rem);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    transition-delay: calc(var(--i) * 40ms + 80ms);
  }

  .drawer[data-open] .drawer__list li {
    opacity: 1;
    transform: none;
  }

  .drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.85em 0.25em;
    border-block-end: 1px solid var(--c-line-faint);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--weight-semibold);
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .drawer__link :global(.icon) {
    color: var(--c-text-faint);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .drawer__link:hover,
  .drawer__link[aria-current='page'] {
    color: var(--c-text);
  }

  .drawer__link:hover :global(.icon) {
    transform: translateX(0.2em);
    color: var(--c-accent);
  }

  .drawer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: auto;
  }

  .drawer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--c-line-faint);
  }

  /* ------------------------------------------------------------ responsive -- */

  @media (max-width: 66rem) {
    .searchbtn__label,
    .searchbtn__kbd {
      display: none;
    }
    .searchbtn {
      padding: 0.5em;
    }
    .header__links {
      display: none;
    }
  }

  @media (max-width: 60rem) {
    .nav {
      display: none;
    }
    .header__theme,
    .header__locale {
      display: none;
    }
    .header__burger {
      display: grid;
    }
  }

  @media (min-width: 60.0625rem) {
    .drawer {
      display: none;
    }
  }

  /* Burger swaps to a close glyph while the drawer is open. */
  .header__burger[aria-expanded='true'] .header__burger-open {
    display: none;
  }

  .header__burger[aria-expanded='true'] .header__burger-close {
    display: block;
  }
</style>

<script>
  import { initHeader } from '../../scripts/header';
  initHeader();
</script>
