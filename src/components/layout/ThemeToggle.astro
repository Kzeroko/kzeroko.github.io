---
import Icon from '../base/Icon.astro';
import { useTranslations, type LocaleCode } from '../../i18n';

interface Props {
  lang: LocaleCode;
  class?: string;
  /** Forwarded to the root so a parent's scoped styles can reach it. */
  [key: string]: unknown;
}

const { lang, class: className, ...rest } = Astro.props;
const t = useTranslations(lang);

const options = [
  { value: 'light', icon: 'sun', label: t('action.theme.light') },
  { value: 'system', icon: 'monitor', label: t('action.theme.system') },
  { value: 'dark', icon: 'moon', label: t('action.theme.dark') },
] as const;
---

<div class:list={['theme', className]} role="radiogroup" aria-label={t('action.theme')} {...rest}>
  {
    options.map((option) => (
      <button
        type="button"
        class="theme__option"
        role="radio"
        aria-checked="false"
        aria-label={option.label}
        title={option.label}
        data-theme-option={option.value}
      >
        <Icon name={option.icon} />
      </button>
    ))
  }
</div>

<style>
  .theme {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    padding: 2px;
    border-radius: var(--radius-full);
    border: 1px solid var(--c-line);
    background: var(--c-surface-2);
  }

  .theme__option {
    display: grid;
    place-items: center;
    inline-size: 1.85rem;
    block-size: 1.85rem;
    border-radius: var(--radius-full);
    color: var(--c-text-faint);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .theme__option :global(.icon) {
    inline-size: 0.95rem;
    block-size: 0.95rem;
  }

  .theme__option:hover {
    color: var(--c-text);
  }

  .theme__option[aria-checked='true'] {
    background: var(--c-surface);
    color: var(--c-accent);
    box-shadow: var(--shadow-sm);
  }
</style>

<script>
  import { initThemeControls } from '../../scripts/theme';
  initThemeControls();
</script>
