---
import { iconPath, isBrandIcon, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Accessible name. Omit for decorative icons — they render `aria-hidden`. */
  label?: string;
  /** Any CSS length, or a number treated as pixels. Defaults to 1.15em. */
  size?: string | number;
  class?: string;
  /**
   * Remaining attributes are forwarded to the `<svg>`. This matters for more
   * than convenience: Astro passes a parent component's style scope down as a
   * `data-astro-cid-*` prop, so without the spread a parent could never style
   * an icon it rendered by class name.
   */
  [key: string]: unknown;
}

const { name, label, size, class: className, ...rest } = Astro.props;

const brand = isBrandIcon(name);
const length = typeof size === 'number' ? `${size}px` : size;
const sizeStyle = length ? `inline-size:${length};block-size:${length};` : undefined;
---

<svg
  class:list={['icon', brand && 'icon--filled', className]}
  viewBox="0 0 24 24"
  style={sizeStyle}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={iconPath(name)}
/>
