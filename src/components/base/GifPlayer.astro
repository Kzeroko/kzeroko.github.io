---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Icon from './Icon.astro';

/**
 * Click-to-play wrapper for the recorded gameplay GIFs.
 *
 * The forgery clips are 1–4 MB each and six of them sit on one page. Shipping
 * them inline would cost ~11 MB before the reader has decided to look at any
 * of them, so the frame starts as a still and fetches the animation on demand.
 *
 * The stills are pre-generated by `npm run assets` into a `posters/` folder
 * beside each GIF. Astro's own image service keeps animation when it transcodes
 * a GIF, so asking it for a poster would produce another animated file.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Localised label for the play affordance. */
  playLabel: string;
  class?: string;
}

const { src, alt, caption, playLabel, class: className } = Astro.props;

const POSTERS = import.meta.glob<ImageMetadata>('/src/assets/images/**/posters/*.webp', {
  eager: true,
  import: 'default',
});

/** `/_assets/r_forgery_idle.HASH.gif` and `/@fs/…/r_forgery_idle.gif?x` -> `r_forgery_idle`. */
function assetName(url: string): string {
  const file = url.split('?')[0]!.split('/').pop() ?? '';
  return file.split('.')[0]!;
}

const name = assetName(src.src);
const stillPath = Object.keys(POSTERS).find((path) => assetName(path) === name);

// Falls back to the image service if a poster has not been generated yet: the
// result animates, which is worse, but never a broken frame.
const poster = stillPath
  ? POSTERS[stillPath]!
  : await getImage({ src, format: 'webp', quality: 76, width: Math.min(src.width, 800) });
---

<figure class:list={['gif', className]}>
  <button
    class="gif__frame"
    type="button"
    data-gif-src={src.src}
    aria-label={playLabel}
    style={`aspect-ratio:${src.width} / ${src.height}`}
  >
    <img
      class="gif__poster"
      src={poster.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    <span class="gif__badge">
      <Icon name="play" class="gif__icon" />
      <span>{playLabel}</span>
    </span>
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .gif {
    margin-block: var(--space-lg);
  }

  .gif__frame {
    position: relative;
    display: block;
    inline-size: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--c-line);
    overflow: hidden;
    background: var(--c-surface-inset);
    cursor: pointer;
    isolation: isolate;
  }

  .gif__poster {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }

  .gif__frame:hover .gif__poster {
    transform: scale(1.015);
    filter: brightness(1.04);
  }

  .gif__badge {
    position: absolute;
    inset-block-end: var(--space-sm);
    inset-inline-start: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.85em;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--hue-navy-900) 72%, transparent);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: var(--weight-semibold);
    backdrop-filter: blur(8px);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .gif__frame:hover .gif__badge {
    transform: translateY(-2px);
  }

  .gif__icon {
    fill: currentColor;
    stroke: none;
    inline-size: 0.9em;
    block-size: 0.9em;
  }

  /* Set by gif-player.ts once the animation is loaded. */
  .gif__frame[data-playing] {
    cursor: default;
  }

  .gif__frame[data-playing] .gif__badge {
    opacity: 0;
    pointer-events: none;
  }

  .gif__frame[data-loading] .gif__badge {
    animation: pulse-badge 1.1s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    50% {
      opacity: 0.55;
    }
  }
</style>

<script>
  import { initGifPlayers } from '../../scripts/gif-player';
  initGifPlayers();
</script>
