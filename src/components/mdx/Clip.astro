---
import type { ImageMetadata } from 'astro';

import GifPlayer from '../base/GifPlayer.astro';
import { splitLocalePath, useTranslations, type LocaleCode } from '../../i18n';

/** MDX-facing wrapper that supplies the localised play label to `GifPlayer`. */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Defaults to the language of the page being rendered. */
  lang?: LocaleCode;
}

const { src, alt, caption, lang = splitLocalePath(Astro.url.pathname).lang } = Astro.props;
const t = useTranslations(lang);
---

<GifPlayer src={src} alt={alt} caption={caption} playLabel={t('action.playClip')} />
