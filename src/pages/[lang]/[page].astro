---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { mdxComponents } from '../../components/mdx';
import { localeCodes, localePath, useTranslations, type LocaleCode } from '../../i18n';
import { entrySlug, getPages, type PageEntry } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';

/**
 * Standalone prose pages (`about`, and anything else added to the `pages`
 * collection later). Directory routes such as `wiki/` and `blog/` are more
 * specific and always win over this single-segment match.
 */
export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of localeCodes) {
    for (const entry of await getPages(lang)) {
      paths.push({ params: { lang, page: entrySlug(entry) }, props: { entry } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props as Props;
const lang = Astro.params.lang as LocaleCode;
const t = useTranslations(lang);

const { Content, headings } = await render(entry);

const crumbs = [{ label: t('nav.home'), href: localePath(lang) }, { label: entry.data.title }];
---

<ArticleLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  heading={entry.data.title}
  lead={entry.data.description}
  eyebrow={entry.data.eyebrow}
  crumbs={crumbs}
  headings={entry.data.toc ? headings : []}
  hero={entry.data.hero}
  heroAlt={entry.data.heroAlt}
  updatedDate={entry.data.updated}
  modifiedTime={entry.data.updated}
  noindex={entry.data.seo?.noindex}
  jsonLd={[
    breadcrumbJsonLd(
      crumbs.map((crumb) => ({ name: crumb.label, href: crumb.href ?? Astro.url.pathname }))
    ),
  ]}
>
  <Content components={mdxComponents} />
</ArticleLayout>
