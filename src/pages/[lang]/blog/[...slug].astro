---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { mdxComponents } from '../../../components/mdx';
import { localeCodes, localePath, readingTime, useTranslations, type LocaleCode } from '../../../i18n';
import { blogPath, entrySlug, getBlogPosts, localisedPaths, type BlogEntry } from '../../../lib/content';
import { articleJsonLd, breadcrumbJsonLd, buildSeo, formatTitle } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  return localisedPaths('blog', localeCodes);
}) satisfies GetStaticPaths;

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props as Props;
const lang = Astro.params.lang as LocaleCode;
const t = useTranslations(lang);

const { Content, headings } = await render(entry);

const posts = await getBlogPosts(lang);
const index = posts.findIndex((post) => entrySlug(post) === entrySlug(entry));
// `posts` is newest-first, so the next index is the older post.
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const newer = index > 0 ? posts[index - 1] : undefined;

const crumbs = [
  { label: t('nav.home'), href: localePath(lang) },
  { label: t('blog.title'), href: localePath(lang, 'blog') },
  { label: entry.data.title },
];

const seo = buildSeo({
  title: formatTitle(entry.data.title, t('site.title'), false),
  description: entry.data.description,
  lang,
  pathname: Astro.url.pathname,
  type: 'article',
  publishedTime: entry.data.pubDate,
  modifiedTime: entry.data.updatedDate,
});
---

<ArticleLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  heading={entry.data.title}
  lead={entry.data.description}
  eyebrow={t('blog.title')}
  crumbs={crumbs}
  headings={headings}
  hero={entry.data.hero}
  heroAlt={entry.data.heroAlt}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  readingMinutes={readingTime(entry.body ?? '', lang)}
  tags={entry.data.tags}
  type="article"
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  noindex={entry.data.seo?.noindex}
  prev={older
    ? { label: t('blog.prev'), title: older.data.title, href: blogPath(lang, older) }
    : undefined}
  next={newer
    ? { label: t('blog.next'), title: newer.data.title, href: blogPath(lang, newer) }
    : undefined}
  jsonLd={[
    articleJsonLd(seo, lang),
    breadcrumbJsonLd(
      crumbs.map((crumb) => ({ name: crumb.label, href: crumb.href ?? Astro.url.pathname }))
    ),
  ]}
>
  <Content components={mdxComponents} />
</ArticleLayout>
