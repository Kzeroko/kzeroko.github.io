---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/docs/Breadcrumbs.astro';
import type { BaseLayoutProps } from './props';

/**
 * Standard interior page: a masthead followed by whatever the page renders.
 * Used by the section indexes (wiki, codex, blog, KTM2) and by prose pages.
 */
interface Props extends BaseLayoutProps {
  eyebrow?: string;
  heading: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  /** Constrains the body to reading width. */
  narrow?: boolean;
}

const { eyebrow, heading, lead, crumbs, narrow = false, ...base } = Astro.props;
---

<BaseLayout {...base}>
  <div class="masthead">
    <div class:list={['shell', narrow ? 'shell--prose' : 'shell--wide']}>
      {crumbs && crumbs.length > 0 && <Breadcrumbs lang={base.lang} items={crumbs} class="masthead__crumbs" />}
      {eyebrow && <p class="eyebrow masthead__eyebrow">{eyebrow}</p>}
      <h1 class="masthead__title">{heading}</h1>
      {lead && <p class="masthead__lead">{lead}</p>}
      <slot name="masthead" />
    </div>
  </div>

  <slot />
</BaseLayout>

<style>
  .masthead {
    position: relative;
    padding-block: var(--space-2xl) var(--space-xl);
    isolation: isolate;
  }

  /* Soft aurora anchored to the top of the page, echoing the home hero. */
  .masthead::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--header-height) * -1);
    inset-inline: 0;
    block-size: 22rem;
    z-index: -1;
    background:
      radial-gradient(60rem 18rem at 22% 0%, var(--glow-a), transparent 65%),
      radial-gradient(46rem 16rem at 78% 12%, var(--glow-b), transparent 70%);
    opacity: 0.85;
    pointer-events: none;
  }

  .masthead__crumbs {
    margin-block-end: var(--space-lg);
  }

  .masthead__eyebrow {
    margin-block-end: var(--space-sm);
  }

  .masthead__title {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    max-inline-size: 20ch;
    animation: rise-in var(--dur-slow) var(--ease-out) both;
  }

  .masthead__lead {
    margin-block-start: var(--space-lg);
    max-inline-size: 60ch;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--c-text-muted);
    text-wrap: pretty;
    animation: rise-in var(--dur-slow) var(--ease-out) both;
    animation-delay: 80ms;
  }
</style>
